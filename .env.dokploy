# OpenClaw Dokploy Environment Configuration
# Copy this file to .env and fill in your values

# Domain Configuration (REQUIRED)
# Your domain where OpenClaw will be accessible
OPENCLAW_DOMAIN=openclaw.example.com

# Gateway Authentication (REQUIRED - Choose one)
# Generate a secure token: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=your-secure-token-here
# OR use a password instead
# OPENCLAW_GATEWAY_PASSWORD=your-secure-password-here

# Docker Image (Optional - defaults to latest)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# AI Provider Configuration (At least one required)

# Claude AI (Anthropic) - Recommended
# Get from: https://claude.ai
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# OpenAI API
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API (alternative to Claude session)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Other AI Providers (Optional)
# GOOGLE_AI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# BEDROCK_ACCESS_KEY_ID=
# BEDROCK_SECRET_ACCESS_KEY=
# BEDROCK_REGION=

# Messaging Channels (Optional - configure after deployment)
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# Advanced Configuration (Optional)
# OPENCLAW_CONFIG_DIR=/home/node/.openclaw
# OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790
# NODE_ENV=production
